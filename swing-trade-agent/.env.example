# ---------------------------------------------------------------------------
# Swing Trade Signal Agent — environment configuration
# Copy to `.env` and fill in. NEVER commit a real .env with live keys.
# ---------------------------------------------------------------------------

# --- Trading 212 (READ-ONLY, DEMO by default) ------------------------------
# OPTIONAL. Leave BLANK to just chat / test the app — the portfolio tools
# simply return "no key configured" and everything else works. Only fill this
# in when you want it to read your real DEMO positions: create a READ-ONLY API
# key in the Trading 212 DEMO account and paste it after the = below. The app
# never places orders; a read-only key is all it needs.
T212_API_KEY=
# Optional. If set, Basic auth (base64 of KEY:SECRET) is used; otherwise the
# key is sent directly in the Authorization header (T212 public API style).
T212_API_SECRET=
# Defaults to the demo host. Do NOT point this at the live host.
T212_BASE_URL=https://demo.trading212.com/api/v0

# --- Price provider --------------------------------------------------------
PRICE_PROVIDER=yfinance
PRICE_CACHE_DIR=.cache/prices
# Only needed if you switch PRICE_PROVIDER to these:
ALPHA_VANTAGE_API_KEY=
TWELVE_DATA_API_KEY=

# --- News / events provider (agent context; optional, free-tier) -----------
# Default provider is Finnhub (free tier: company news + earnings calendar).
# Get a free key at https://finnhub.io. Only the agent's get_news /
# get_upcoming_events tools use this; unset -> those tools return "no data".
NEWS_PROVIDER=finnhub
NEWS_API_KEY=
NEWS_BASE_URL=https://finnhub.io/api/v1

# --- Anthropic (reasoning layer ONLY — never used for signal math) ---------
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-4-8

# --- Supabase output (optional) --------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Email digest via Resend (optional) ------------------------------------
RESEND_API_KEY=
DIGEST_FROM="Swing Agent <onboarding@resend.dev>"
DIGEST_TO=you@example.com

# --- Pipeline tuning -------------------------------------------------------
# Composite-score threshold a symbol must reach to be reported (0..1).
SIGNAL_THRESHOLD=0.4
# Trading days of history to fetch per symbol (>= 210 needed for SMA200).
HISTORY_DAYS=400
